{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "src/lib/api/gen/**", "src/app/route-tree.gen.ts", "src/locales/**"],
  "rules": {
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-imports": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "unicorn/no-null": "off",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/routes/**", "@/features/**", "@/components/**"],
                "message": "lib/ is the bottom layer: it must not import UI, features or routes (AGENTS.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/routes/**", "@/features/**", "@/components/patterns/**"],
                "message": "components/ui only depends on lib/ (AGENTS.md)."
              }
            ]
          }
        ],
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["src/components/patterns/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/routes/**", "@/features/**"],
                "message": "Design-kit patterns must stay feature-agnostic (AGENTS.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/routes/**"],
                "message": "Features are composed by routes, not the other way around (AGENTS.md)."
              },
              {
                "group": ["@/features/*/**"],
                "message": "Import another feature only through its public index: '@/features/<name>' (AGENTS.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
