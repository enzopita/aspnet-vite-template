// OpenCode project config for executor agents (ADR 0008). AGENTS.md is loaded automatically; the protocol lives in
// .agents/skills/execute-task. The `.opencode/plugins/app-guard/index.mjs` plugin (V2 API) enforces role-aware worktree
// guards; static `permissions` below serve as a second defense layer mirroring PROTECTED + GENERATED in
// scripts/agents/lib.mjs (kept in sync by agents.test.mjs).
{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Hooks, gates and history belong to humans and the orchestrator.
    { "action": "shell", "resource": "*--no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "*LEFTHOOK*", "effect": "deny" },
    { "action": "shell", "resource": "*lefthook install*", "effect": "deny" },
    { "action": "shell", "resource": "*lefthook uninstall*", "effect": "deny" },
    { "action": "shell", "resource": "*core.hooksPath*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git tag *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git update-ref *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D *", "effect": "deny" },
    { "action": "shell", "resource": "git switch main*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout main*", "effect": "deny" },

    // Dependencies change only through a task that unlocks the manifests.
    { "action": "shell", "resource": "pnpm add *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm * add *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm remove *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm * remove *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm update *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm * update *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm dlx shadcn*", "effect": "deny" },
    { "action": "shell", "resource": "npm install *", "effect": "deny" },
    { "action": "shell", "resource": "npm i *", "effect": "deny" },
    { "action": "shell", "resource": "yarn add *", "effect": "deny" },
    { "action": "shell", "resource": "dotnet add *package*", "effect": "deny" },
    { "action": "shell", "resource": "dotnet remove *package*", "effect": "deny" },
    { "action": "shell", "resource": "dotnet package *", "effect": "deny" },
    { "action": "shell", "resource": "dotnet ef migrations remove*", "effect": "deny" },

    // Protected files: rules, gates, dependency manifests, decisions, design-kit primitives.
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "src/AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "web/AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "CLAUDE.md", "effect": "deny" },
    { "action": "edit", "resource": "GEMINI.md", "effect": "deny" },
    { "action": "edit", "resource": ".agents/*", "effect": "deny" },
    { "action": "edit", "resource": ".claude/*", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/*", "effect": "deny" },
    { "action": "edit", "resource": "opencode.json", "effect": "deny" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": ".mcp.json", "effect": "deny" },
    { "action": "edit", "resource": ".github/*", "effect": "deny" },
    { "action": "edit", "resource": "scripts/*", "effect": "deny" },
    { "action": "edit", "resource": "lefthook.yml", "effect": "deny" },
    { "action": "edit", "resource": ".editorconfig", "effect": "deny" },
    { "action": "edit", "resource": ".gitattributes", "effect": "deny" },
    { "action": "edit", "resource": ".gitignore", "effect": "deny" },
    { "action": "edit", "resource": "global.json", "effect": "deny" },
    { "action": "edit", "resource": "dotnet-tools.json", "effect": "deny" },
    { "action": "edit", "resource": "Directory.Build.props", "effect": "deny" },
    { "action": "edit", "resource": "Directory.Build.targets", "effect": "deny" },
    { "action": "edit", "resource": "Directory.Packages.props", "effect": "deny" },
    { "action": "edit", "resource": "governance/*", "effect": "deny" },
    { "action": "edit", "resource": "tests/Directory.Build.props", "effect": "deny" },
    { "action": "edit", "resource": "tests/App.ArchitectureTests/*", "effect": "deny" },
    { "action": "edit", "resource": "App.slnx", "effect": "deny" },
    { "action": "edit", "resource": "Dockerfile", "effect": "deny" },
    { "action": "edit", "resource": "compose.yaml", "effect": "deny" },
    { "action": "edit", "resource": "docs/adr/*", "effect": "deny" },
    { "action": "edit", "resource": "docs/glossary.md", "effect": "deny" },
    { "action": "edit", "resource": "docs/agents/*", "effect": "deny" },
    { "action": "edit", "resource": "web/package.json", "effect": "deny" },
    { "action": "edit", "resource": "web/pnpm-lock.yaml", "effect": "deny" },
    { "action": "edit", "resource": "web/pnpm-workspace.yaml", "effect": "deny" },
    { "action": "edit", "resource": "web/commitlint.config.mjs", "effect": "deny" },
    { "action": "edit", "resource": "web/.oxlintrc.json", "effect": "deny" },
    { "action": "edit", "resource": "web/.oxfmtrc.json", "effect": "deny" },
    { "action": "edit", "resource": "web/tsconfig*.json", "effect": "deny" },
    { "action": "edit", "resource": "web/vite.config.ts", "effect": "deny" },
    { "action": "edit", "resource": "web/vitest.config.ts", "effect": "deny" },
    { "action": "edit", "resource": "web/kubb.config.ts", "effect": "deny" },
    { "action": "edit", "resource": "web/lingui.config.ts", "effect": "deny" },
    { "action": "edit", "resource": "web/react-doctor.config.json", "effect": "deny" },
    { "action": "edit", "resource": "web/components.json", "effect": "deny" },
    { "action": "edit", "resource": "web/src/styles/tokens.css", "effect": "deny" },
    { "action": "edit", "resource": "web/src/components/ui/*", "effect": "deny" },

    // Generated: run the generator instead (pnpm --dir web api:generate / build).
    { "action": "edit", "resource": "web/openapi/*", "effect": "deny" },
    { "action": "edit", "resource": "web/src/lib/api/gen/*", "effect": "deny" },
    { "action": "edit", "resource": "web/src/app/route-tree.gen.ts", "effect": "deny" },

    // Planner/reviewer skills belong to the orchestrator; executors use execute-task.
    { "action": "skill", "resource": "plan-task", "effect": "deny" },
    { "action": "skill", "resource": "review-task", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      "microsoft-learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp",
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "nuget": {
        "type": "local",
        "command": ["dnx", "NuGet.Mcp.Server", "--source", "https://api.nuget.org/v3/index.json", "--yes"],
      },
    },
  },
}
