root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

# --- Namespaces & usings ---
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# --- Style ---
# Every code-style (IDE) recommendation the .NET language server shows is a build error (warnings-as-errors +
# EnforceCodeStyleInBuild), so code is clean before review. Opt-outs below are the few rules that fight the
# house style; anything else the IDE suggests gets fixed, not suppressed.
dotnet_analyzer_diagnostic.category-Style.severity = warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_prefer_primary_constructors = true:warning
csharp_prefer_braces = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_style_readonly_field = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

csharp_style_expression_bodied_constructors = when_on_single_line:warning
csharp_style_expression_bodied_operators = when_on_single_line:warning
# Opt-outs: refactorings the IDE only offers (hidden by default), not recommendations.
# IDE0058: discarding every unused return value with `_ =` is noise (fluent builders, Add/Remove calls).
dotnet_diagnostic.IDE0058.severity = none
# IDE0045/IDE0046: `if`/`return` chains often read better than nested ternaries.
dotnet_diagnostic.IDE0045.severity = none
dotnet_diagnostic.IDE0046.severity = none

# --- Naming --- (IDE1006 must be set explicitly for naming rules to fail the build)
dotnet_diagnostic.IDE1006.severity = warning
# Private constants and static readonly fields: PascalCase (they read like constants).
dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal
dotnet_naming_rule.private_constants_pascal.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const

dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

# Mutable private static fields: s_camelCase (rare; shared state must stand out).
dotnet_naming_rule.private_static_s.symbols = private_static
dotnet_naming_rule.private_static_s.style = s_camel
dotnet_naming_rule.private_static_s.severity = warning
dotnet_naming_symbols.private_static.applicable_kinds = field
dotnet_naming_symbols.private_static.applicable_accessibilities = private
dotnet_naming_symbols.private_static.required_modifiers = static
dotnet_naming_style.s_camel.required_prefix = s_
dotnet_naming_style.s_camel.capitalization = camel_case

dotnet_naming_style.pascal.capitalization = pascal_case

# Private instance fields: _camelCase.
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.interfaces_i.symbols = interfaces
dotnet_naming_rule.interfaces_i.style = prefix_i
dotnet_naming_rule.interfaces_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# --- Analyzer tuning ---
# Suggestion-level rules the build doesn't print but the editor shows: promoted, so they fail the build.
# ASP0018 (unused route parameter): bind route values in the handler, e.g. `Guid orderId`.
dotnet_diagnostic.ASP0018.severity = warning
# ConfigureAwait is irrelevant in ASP.NET Core (no sync context).
dotnet_diagnostic.CA2007.severity = none
# Localized messages flow through IStringLocalizer / problem codes, not literals checks.
dotnet_diagnostic.CA1303.severity = none
# Minimal API handlers and EF entities are intentionally not sealed everywhere.
dotnet_diagnostic.CA1515.severity = none
# Static holder classes for slice endpoints are a convention.
dotnet_diagnostic.CA1724.severity = none
# xUnit test method names use underscores.
dotnet_diagnostic.CA1707.severity = none
# App is C#-only; names like `Error` colliding with VB keywords don't matter.
dotnet_diagnostic.CA1716.severity = none
# `Result<T>.Success(...)` / `Failure(...)` static factories are the intended API.
dotnet_diagnostic.CA1000.severity = none
# Missing XML docs are fine; public surface is mostly internal.
dotnet_diagnostic.CS1591.severity = none
# Banned APIs (governance/BannedSymbols*.txt) and skipped xUnit tests must fail the build.
dotnet_diagnostic.RS0030.severity = error
dotnet_diagnostic.xUnit1004.severity = error

# xunit.v3.core.mtp-v2 generates a synchronous Main in obj/ calling .GetAwaiter().GetResult().
[**/obj/**/XunitAutoGeneratedEntryPoint.cs]
dotnet_diagnostic.RS0030.severity = none

[tests/**.cs]
# Tests can use literal strings and don't need culture-aware overloads everywhere.
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA2234.severity = none

# EF Core migrations are generated: never hand-edit them to satisfy style rules.
[**/Migrations/*.cs]
generated_code = true

# Aspire convention: service defaults live in the hosting namespace so `AddServiceDefaults()` is found without a using.
[src/App.ServiceDefaults/**.cs]
dotnet_diagnostic.IDE0130.severity = none

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.{json,jsonc,yaml,yml}]
indent_size = 2
